root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{json,yaml,yml,html,css,js}]
indent_size = 2

[*.ps1]
end_of_line = crlf

[Makefile]
indent_style = tab

# Canonical evidence bytes are covered by manifest checksums.
[grasp-gold-evidence-builder/outputs/grasp-gold-evidence/**]
insert_final_newline = unset
end_of_line = unset
charset = unset
